# Template for a MANUAL production build. Copy to .env.production, which is
# git-ignored (ALL-31): the tracked .env.production carried a live Google Maps
# API key and, worse, said VITE_APP_ENVIRONMENT=dev -- CI overwrites that file
# so deploys were fine, but anyone running `npm run build` locally produced a
# "production" bundle labelled dev.
#
# Secrets come from Secret Manager / CI, never from this file.

VITE_APP_VERSION=v1.0.0
GENERATE_SOURCEMAP=false

# Backend API URL
VITE_APP_API_URL=https://api.allyvia.co/api/v1
VITE_APP_BASE_NAME=/

# QuickBooks Integration
VITE_APP_QB_CALLBACK_URL=https://app.allyvia.co/quickbooks-callback

# Square Integration
VITE_APP_SQUARE_CALLBACK_URL=https://app.allyvia.co/square-callback

# Environment
VITE_APP_ENVIRONMENT=production

# Production optimizations
VITE_USE_MOCK_API=false

VITE_GOOGLE_MAPS_API_KEY=

# Error tracking (ALL-44). Empty = Sentry is not initialised, which is the right
# default locally. The real DSN comes from CI/Secret Manager, never this file.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Stamped by the deploy workflows as the commit SHA, and used as the Sentry
# release so a frontend error lines up with a backend traceback from the same
# deploy. The old hardcoded VITE_APP_VERSION=v1.0.0 identified nothing.
VITE_APP_COMMIT_SHA=
