# Resolve project binaries (husky's shim does this too; repeated so the hook
# also works when invoked directly).
PATH="node_modules/.bin:$PATH"
export PATH

# GUI git clients (GitHub Desktop, VS Code, Tower, Fork) run hooks with a minimal
# PATH that does not include nvm / homebrew / volta / fnm node. Locate node first,
# otherwise the hook dies with "npx: command not found" and unformatted code ships.

if ! command -v node >/dev/null 2>&1; then
  if [ -s "$HOME/.nvm/nvm.sh" ]; then
    . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1 || true
  fi
fi

if ! command -v node >/dev/null 2>&1; then
  for dir in \
    /opt/homebrew/bin \
    /usr/local/bin \
    "$HOME/.volta/bin" \
    "$HOME/.asdf/shims" \
    "$HOME/Library/Application Support/fnm/aliases/default/bin" \
    "$HOME/.nvm/versions/node"/*/bin
  do
    if [ -x "$dir/node" ]; then
      PATH="$dir:$PATH"
      export PATH
      break
    fi
  done
fi

if ! command -v node >/dev/null 2>&1; then
  echo ""
  echo "husky: could not find node, so formatting was NOT checked."
  echo "  Your commit will likely fail CI on prettier warnings."
  echo "  Fix: commit from a terminal, or create ~/.config/husky/init.sh with"
  echo "  the PATH export (or nvm sourcing) your shell uses."
  echo ""
  exit 1
fi

lint-staged
