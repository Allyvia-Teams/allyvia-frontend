VITE_APP_VERSION=v1.0.0
GENERATE_SOURCEMAP=false


## Backend API URL
VITE_APP_API_URL=http://localhost:8000/api/v1
VITE_APP_BASE_NAME=/


## Mock API Configuration
## Set to true to use mock API for development (no backend required)
## Set to false or remove to use real backend API
VITE_USE_MOCK_API=false


## Insights redesign (src/features/insights/flag.ts)
##   off   today's /insights page, unchanged. The PRODUCTION default: leave it unset there.
##   mock  the new page, from src/features/insights/mock/insights.mock.ts. The STAGING value,
##         for demos (see docs/insights-redesign/README.md, "How to demo the new Insights page").
##   live  the new page, from the agent recommendation endpoints. Flip to live only once the
##         backend supplies steps, an impact kind/label, a primary action and actionPayload per
##         recommendation ("Backend wiring" in the same README); until then live cards read
##         "estimated impact", "Review" and an empty steps list.
## Unset = mock under `vite` dev, off in builds.
# VITE_INSIGHTS_REDESIGN=mock


## QuickBooks Integration
## This should match exactly what is in the REDIRECT_URL value for the Backend environment variable as well as the redirect url in the Quickbooks Developer portal
VITE_APP_QB_CALLBACK_URL=http://localhost:3000/quickbooks-callback


## Xero Integration (ALL-248)
## Must match XERO_REDIRECT_URI on the backend and the redirect URI registered
## in the Xero developer portal (Session 1's human verification gate).
VITE_APP_XERO_CALLBACK_URL=http://localhost:3000/xero-callback


